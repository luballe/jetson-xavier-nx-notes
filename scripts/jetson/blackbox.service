# sudo install -m 755 blackbox.py /usr/local/sbin/blackbox.py
# sudo install -m 644 blackbox.service /etc/systemd/system/blackbox.service
# sudo systemctl daemon-reload && sudo systemctl enable --now blackbox
[Unit]
Description=Flight recorder: system state every 5 s, fsynced, to /var/log/blackbox.log
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/blackbox.py
Restart=always
RestartSec=5
Nice=-5
CPUQuota=5%
MemoryMax=40M

[Install]
WantedBy=multi-user.target
